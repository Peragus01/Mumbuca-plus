{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:chain": "vitest run --config vitest.chain.config.ts",
    "probe:ozav": "tsx scripts/ozav-brs-probe.ts",
    "start": "node dist/src/main.js",
    "init:program": "tsx scripts/init-program.ts",
    "smoke:mint": "tsx scripts/mint-smoke.ts",
    "pause:program": "tsx scripts/pause-program.ts --pause",
    "unpause:program": "tsx scripts/pause-program.ts --unpause",
    "set:metadata-uri": "tsx scripts/set-metadata-uri.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@solana/web3.js": "^1.99.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
